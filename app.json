{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "co.hf.reachy",
  "version": "1.2.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Reachy Mini Controller"
  },
  "description": {
    "en": "Use the Huggingface Reachy Mini Robot as the Eyes, Ears, and Voice for Homey."
  },
  "category": [
    "appliances"
  ],
  "permissions": [
    "homey:manager:geolocation",
    "homey:manager:api"
  ],
  "brandColor": "#148F96",
  "api": {
    "command": {
      "method": "POST",
      "path": "/command"
    },
    "info": {
      "method": "GET",
      "path": "/info"
    },
    "setup": {
      "method": "GET",
      "path": "/setup"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Jeff Singleton",
    "email": "gvibe06@gmail.com"
  },
  "flow": {
    "triggers": [
      {
        "id": "command_received",
        "title": {
          "en": "Reachy received a voice command"
        },
        "titleFormatted": {
          "en": "Reachy received a command containing [[match]]"
        },
        "hint": {
          "en": "Fires when Reachy's conversation tool sends a command to Homey that contains the given text. Use the Command token in your actions."
        },
        "args": [
          {
            "type": "text",
            "name": "match",
            "title": {
              "en": "Command contains"
            },
            "placeholder": {
              "en": "lights off"
            }
          }
        ],
        "tokens": [
          {
            "name": "command",
            "type": "string",
            "title": {
              "en": "Command"
            },
            "example": "turn off the living room lights"
          }
        ]
      },
      {
        "id": "face_detected",
        "title": {
          "en": "A face appeared"
        },
        "titleFormatted": {
          "en": "A face appeared"
        },
        "hint": {
          "en": "Fires when Reachy turns its head to track a face (requires \"Watch for face-tracking motion\" enabled, plus a face-tracking app running on the robot). Tokens carry the head yaw/pitch it turned to."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ],
        "tokens": [
          {
            "name": "x",
            "type": "number",
            "title": {
              "en": "Face X"
            },
            "example": 0.12
          },
          {
            "name": "y",
            "type": "number",
            "title": {
              "en": "Face Y"
            },
            "example": -0.05
          }
        ]
      },
      {
        "id": "heard_speech",
        "title": {
          "en": "Heard someone speak"
        },
        "titleFormatted": {
          "en": "Heard someone speak"
        },
        "hint": {
          "en": "Fires when Reachy's mic array detects speech, with the direction it came from. Requires \"Listen for sounds\" enabled and no camera app (eyes) running."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ],
        "tokens": [
          {
            "name": "direction",
            "type": "number",
            "title": {
              "en": "Direction (°)"
            },
            "example": 138
          },
          {
            "name": "direction_label",
            "type": "string",
            "title": {
              "en": "Direction"
            },
            "example": "front"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "announce_time",
        "title": {
          "en": "Announce the time"
        },
        "titleFormatted": {
          "en": "Announce the time in [[format]] format"
        },
        "hint": {
          "en": "Reachy speaks the current time. The clock format is configurable per card."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          },
          {
            "type": "dropdown",
            "name": "format",
            "title": {
              "en": "Time format"
            },
            "value": "device",
            "values": [
              {
                "id": "device",
                "label": {
                  "en": "Device default"
                }
              },
              {
                "id": "12",
                "label": {
                  "en": "12-hour (3:15 PM)"
                }
              },
              {
                "id": "24",
                "label": {
                  "en": "24-hour (15:15)"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "announce_time_weather",
        "title": {
          "en": "Announce the time and weather"
        },
        "titleFormatted": {
          "en": "Announce the time and weather"
        },
        "hint": {
          "en": "Reachy speaks the current time and current weather, cuckoo-clock style."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ]
      },
      {
        "id": "express_emotion",
        "title": {
          "en": "Express an emotion"
        },
        "titleFormatted": {
          "en": "Express [[emotion]]"
        },
        "hint": {
          "en": "Reachy performs a short expressive motion with its head and antennas."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          },
          {
            "type": "dropdown",
            "name": "emotion",
            "title": {
              "en": "Emotion"
            },
            "value": "happy",
            "values": [
              {
                "id": "happy",
                "label": {
                  "en": "Happy"
                }
              },
              {
                "id": "sad",
                "label": {
                  "en": "Sad"
                }
              },
              {
                "id": "curious",
                "label": {
                  "en": "Curious"
                }
              },
              {
                "id": "excited",
                "label": {
                  "en": "Excited"
                }
              },
              {
                "id": "confused",
                "label": {
                  "en": "Confused"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "gesture_look",
        "title": {
          "en": "Look in a direction"
        },
        "titleFormatted": {
          "en": "Look [[direction]]"
        },
        "hint": {
          "en": "Reachy turns its head to look in a direction."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          },
          {
            "type": "dropdown",
            "name": "direction",
            "title": {
              "en": "Direction"
            },
            "value": "center",
            "values": [
              {
                "id": "left",
                "label": {
                  "en": "Left"
                }
              },
              {
                "id": "right",
                "label": {
                  "en": "Right"
                }
              },
              {
                "id": "up",
                "label": {
                  "en": "Up"
                }
              },
              {
                "id": "down",
                "label": {
                  "en": "Down"
                }
              },
              {
                "id": "center",
                "label": {
                  "en": "Center"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "gesture_nod",
        "title": {
          "en": "Nod (yes)"
        },
        "titleFormatted": {
          "en": "Nod (yes)"
        },
        "hint": {
          "en": "Reachy nods its head up and down. Works best when no camera app is controlling the head."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ]
      },
      {
        "id": "gesture_shake",
        "title": {
          "en": "Shake head (no)"
        },
        "titleFormatted": {
          "en": "Shake head (no)"
        },
        "hint": {
          "en": "Reachy shakes its head left and right. Works best when no camera app is controlling the head."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ]
      },
      {
        "id": "go_to_sleep",
        "title": {
          "en": "Go to sleep"
        },
        "titleFormatted": {
          "en": "Go to sleep"
        },
        "hint": {
          "en": "Play Reachy's go-to-sleep motion."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ]
      },
      {
        "id": "look_at_sound",
        "title": {
          "en": "Look toward the last sound"
        },
        "titleFormatted": {
          "en": "Look toward the last sound"
        },
        "hint": {
          "en": "Reachy turns its head toward the direction of the most recent detected speech (requires \"Listen for sounds\")."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ]
      },
      {
        "id": "play_sound",
        "title": {
          "en": "Play a sound file"
        },
        "titleFormatted": {
          "en": "Play sound [[file]]"
        },
        "hint": {
          "en": "Play a sound already uploaded to Reachy, or a built-in asset name."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          },
          {
            "type": "text",
            "name": "file",
            "title": {
              "en": "File name"
            },
            "placeholder": {
              "en": "chime.mp3"
            }
          }
        ]
      },
      {
        "id": "say_text",
        "title": {
          "en": "Say a message"
        },
        "titleFormatted": {
          "en": "Say [[text]]"
        },
        "hint": {
          "en": "Speak the given text through Reachy's speaker."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          },
          {
            "type": "text",
            "name": "text",
            "title": {
              "en": "Message"
            },
            "placeholder": {
              "en": "Hello from Homey"
            }
          }
        ]
      },
      {
        "id": "set_volume",
        "title": {
          "en": "Set the volume"
        },
        "titleFormatted": {
          "en": "Set volume to [[volume]]%"
        },
        "hint": {
          "en": "Set Reachy's speaker volume (0-100%)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          },
          {
            "type": "range",
            "name": "volume",
            "title": {
              "en": "Volume"
            },
            "min": 0,
            "max": 100,
            "step": 1,
            "value": 60,
            "label": "%",
            "labelDecimals": 0
          }
        ]
      },
      {
        "id": "start_conversation",
        "title": {
          "en": "Start conversation mode"
        },
        "titleFormatted": {
          "en": "Start conversation mode"
        },
        "hint": {
          "en": "Switch Reachy into two-way voice conversation (talk and it replies). This stops the face-tracker/eyes. Pick a personality in the conversation app's web UI on port 7860."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ]
      },
      {
        "id": "stop_conversation",
        "title": {
          "en": "Stop conversation mode"
        },
        "titleFormatted": {
          "en": "Stop conversation mode"
        },
        "hint": {
          "en": "Stop the conversation app and resume Reachy's startup app (the face-tracker/eyes)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ]
      },
      {
        "id": "wake_up",
        "title": {
          "en": "Wake up"
        },
        "titleFormatted": {
          "en": "Wake up"
        },
        "hint": {
          "en": "Play Reachy's wake-up motion."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=reachy-mini"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Reachy Mini"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "volume_set"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "Awake"
          },
          "insightsTitleTrue": {
            "en": "Woke up"
          },
          "insightsTitleFalse": {
            "en": "Went to sleep"
          }
        },
        "volume_set": {
          "title": {
            "en": "Volume"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/reachy-mini/assets/images/small.png",
        "large": "/drivers/reachy-mini/assets/images/large.png",
        "xlarge": "/drivers/reachy-mini/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "enter_address",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection"
          },
          "children": [
            {
              "id": "address",
              "type": "text",
              "label": {
                "en": "Address (host:port)"
              },
              "value": "",
              "hint": {
                "en": "Your Reachy Mini's address, e.g. 192.168.1.42:8000. Set during pairing; change it here if the robot's IP changes."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Announcements"
          },
          "children": [
            {
              "id": "units",
              "type": "dropdown",
              "label": {
                "en": "Temperature units"
              },
              "value": "fahrenheit",
              "values": [
                {
                  "id": "fahrenheit",
                  "label": {
                    "en": "Fahrenheit (°F)"
                  }
                },
                {
                  "id": "celsius",
                  "label": {
                    "en": "Celsius (°C)"
                  }
                }
              ]
            },
            {
              "id": "clock",
              "type": "dropdown",
              "label": {
                "en": "Clock format"
              },
              "value": "12",
              "values": [
                {
                  "id": "12",
                  "label": {
                    "en": "12-hour"
                  }
                },
                {
                  "id": "24",
                  "label": {
                    "en": "24-hour"
                  }
                }
              ]
            },
            {
              "id": "tts_lang",
              "type": "dropdown",
              "label": {
                "en": "Voice language"
              },
              "value": "en",
              "hint": {
                "en": "Language for the Google voice. OpenAI and ElevenLabs detect the language from the text automatically."
              },
              "values": [
                {
                  "id": "en",
                  "label": {
                    "en": "English"
                  }
                },
                {
                  "id": "es",
                  "label": {
                    "en": "Spanish"
                  }
                },
                {
                  "id": "fr",
                  "label": {
                    "en": "French"
                  }
                },
                {
                  "id": "de",
                  "label": {
                    "en": "German"
                  }
                },
                {
                  "id": "it",
                  "label": {
                    "en": "Italian"
                  }
                },
                {
                  "id": "pt",
                  "label": {
                    "en": "Portuguese"
                  }
                },
                {
                  "id": "nl",
                  "label": {
                    "en": "Dutch"
                  }
                },
                {
                  "id": "pl",
                  "label": {
                    "en": "Polish"
                  }
                },
                {
                  "id": "ru",
                  "label": {
                    "en": "Russian"
                  }
                },
                {
                  "id": "sv",
                  "label": {
                    "en": "Swedish"
                  }
                },
                {
                  "id": "tr",
                  "label": {
                    "en": "Turkish"
                  }
                },
                {
                  "id": "ja",
                  "label": {
                    "en": "Japanese"
                  }
                },
                {
                  "id": "ko",
                  "label": {
                    "en": "Korean"
                  }
                },
                {
                  "id": "zh-CN",
                  "label": {
                    "en": "Chinese"
                  }
                }
              ]
            },
            {
              "id": "speak_gesture",
              "type": "checkbox",
              "label": {
                "en": "Wiggle antennas while speaking"
              },
              "value": true
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Voice"
          },
          "children": [
            {
              "id": "tts_provider",
              "type": "dropdown",
              "label": {
                "en": "Voice provider"
              },
              "value": "openai",
              "hint": {
                "en": "OpenAI and ElevenLabs need an API key below. Without a valid key, Reachy automatically falls back to the free Google voice."
              },
              "values": [
                {
                  "id": "openai",
                  "label": {
                    "en": "OpenAI (recommended, needs API key)"
                  }
                },
                {
                  "id": "elevenlabs",
                  "label": {
                    "en": "ElevenLabs (needs API key)"
                  }
                },
                {
                  "id": "google",
                  "label": {
                    "en": "Google Translate (free, robotic)"
                  }
                }
              ]
            },
            {
              "id": "tts_api_key",
              "type": "password",
              "label": {
                "en": "API key"
              },
              "value": "",
              "hint": {
                "en": "Your OpenAI or ElevenLabs API key. Not used by Google."
              }
            },
            {
              "id": "tts_model",
              "type": "dropdown",
              "label": {
                "en": "OpenAI model"
              },
              "value": "tts-1-hd",
              "hint": {
                "en": "Only used when the provider is OpenAI."
              },
              "values": [
                {
                  "id": "tts-1-hd",
                  "label": {
                    "en": "HD — highest quality"
                  }
                },
                {
                  "id": "tts-1",
                  "label": {
                    "en": "Standard — faster/cheaper"
                  }
                },
                {
                  "id": "gpt-4o-mini-tts",
                  "label": {
                    "en": "GPT-4o mini TTS — newest"
                  }
                }
              ]
            },
            {
              "id": "tts_voice",
              "type": "dropdown",
              "label": {
                "en": "OpenAI voice"
              },
              "value": "onyx",
              "hint": {
                "en": "Only used when the provider is OpenAI."
              },
              "values": [
                {
                  "id": "alloy",
                  "label": {
                    "en": "Alloy — neutral"
                  }
                },
                {
                  "id": "echo",
                  "label": {
                    "en": "Echo — warm male"
                  }
                },
                {
                  "id": "fable",
                  "label": {
                    "en": "Fable — expressive"
                  }
                },
                {
                  "id": "onyx",
                  "label": {
                    "en": "Onyx — deep male"
                  }
                },
                {
                  "id": "nova",
                  "label": {
                    "en": "Nova — bright female"
                  }
                },
                {
                  "id": "shimmer",
                  "label": {
                    "en": "Shimmer — soft female"
                  }
                }
              ]
            },
            {
              "id": "tts_elevenlabs_voice",
              "type": "text",
              "label": {
                "en": "ElevenLabs voice ID"
              },
              "value": "",
              "hint": {
                "en": "Optional ElevenLabs voice ID. Leave blank for the ElevenLabs default voice. Only used when the provider is ElevenLabs."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Vision (Eyes)"
          },
          "children": [
            {
              "id": "face_detection",
              "type": "checkbox",
              "label": {
                "en": "Watch for face-tracking motion"
              },
              "value": false,
              "hint": {
                "en": "Enables the \"A face appeared\" trigger by watching the robot's head turn toward a face. Requires a face-tracking app running on the robot (the daemon exposes no direct face signal)."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Hearing (Ears)"
          },
          "children": [
            {
              "id": "listen_doa",
              "type": "checkbox",
              "label": {
                "en": "Listen for sounds"
              },
              "value": false,
              "hint": {
                "en": "Enables the \"Heard someone speak\" trigger using the mic array (direction of arrival). Acquires the robot's mic, so it cannot run at the same time as a camera app (the face-tracker eyes)."
              }
            }
          ]
        }
      ],
      "id": "reachy-mini"
    }
  ]
}